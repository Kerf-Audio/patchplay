kerf 1
tempo 130
key A minor
style acid-line seed 1
tags four-four acid

module tally1 Tally tempo=0.5 swing=0.1 divide=0.5
module mix    Router level1=0.5 level2=0.38 level3=0.8 level4=0.55 level5=0.7 level6=0.5
module out    Finish volume=0.68 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d
  module ruler1 Ruler   hits_a=0.25 steps_a=1 hits_b=0.64 steps_b=0.867 hits_c=0.4 steps_c=0.267 hits_d=0 chance=0.75
  module ruler2 Ruler   hits_a=0.125 steps_a=1 hits_b=0.15 steps_b=0.4 hits_c=0 hits_d=0 rotate=0.25 chance=0.5
  module ruler3 Ruler   hits_a=0.25 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0.125
  module kick   Mortise engine=0 pitch=0.35 punch=0.7 decay=0.28 tone=0.45
  module chat   Mortise engine=0.5 pitch=0.55 punch=0.5 decay=0.1 tone=0.7
  module clap   Mortise engine=0.75 pitch=0.5 punch=0.6 decay=0.4 tone=0.5
  module ohat   Mortise engine=0.5 pitch=0.45 punch=0.4 decay=0.35 tone=0.6
  module tom    Mortise engine=1 pitch=0.6 punch=0.6 decay=0.2 tone=0.5
  module duck   Bevel   attack=0 decay=0.4 sustain=0 release=0.4 curve=0.3

part bass "Acid bass" colour #3d63c9
  module bseq   Dovetail steps_a=1 steps_b=0.87 interlock=0.75 chance=0.85 glide=0.25 range=0.3
  module bfret  Fret     root=0.75 scale=0.857 octave=0.375
  module bosc   Chisel   tune=0.5 shape=0 pw=0.5
  module benv   Bevel    attack=0 decay=0.38 sustain=0 release=0.2 curve=0.3
  module bdrive Rasp     drive=0.25 fold=0.2 bias=0.55 mix=0.9
  module bflt   Plane    cutoff=0.28 res=0.82 mode=0 drive=0.3
  module bamp   Clamp    level=0 response=0.1
  module bduck  Clamp    level=0 response=0
  module sweep  Spokeshave rate=0.08 spread=0.4 shape=0 phase=0.25
  module slev   Clamp    level=0.45 response=0
  module echo   Bandsaw  time=0.5 feedback=0.45 wear=0.35 mix=0.3

cable tally1.clock -> ruler1.clock
cable tally1.clock -> ruler2.clock
cable tally1.clock -> ruler3.clock
cable ruler1.a -> kick.trig
cable ruler1.a -> duck.gate
cable ruler1.b -> chat.trig
cable ruler1.c -> tom.trig
cable ruler2.a -> clap.trig
cable ruler2.b -> clap.trig
cable ruler3.a -> ohat.trig
cable kick.out -> mix.in1
cable chat.out -> mix.in3
cable clap.out -> mix.in4
cable ohat.out -> mix.in5
cable tom.out -> mix.in6

cable tally1.clock -> bseq.clock
cable bseq.pitch -> bfret.pitch
cable bfret.pitch -> bosc.voct
cable bseq.gate -> benv.gate
cable bosc.saw -> bdrive.in
cable bseq.accent -> bdrive.drive
cable bdrive.out -> bflt.in
cable benv.env -> bflt.cutoff
cable sweep.lfo1 -> slev.in
cable slev.out -> bflt.cutoff
cable bflt.out -> bamp.in
cable benv.env -> bamp.cv
cable bamp.out -> bduck.in
cable duck.inverted -> bduck.cv
cable bduck.out -> echo.in
cable tally1.clock -> echo.clock
cable echo.l -> mix.in2
cable echo.r -> mix.in2

cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
