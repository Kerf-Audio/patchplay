kerf 1
tempo 60
key C minor
tags abstract drone

module tally1 Tally tempo=0.5 swing=0 divide=0.5
module mix    Router level1=0.5 level2=0.5 level3=0.8 level4=0.45 level5=0.45 level6=0 send=0.4
module room   Kiln   size=0.9 heat=0.4 bloom=0.7 mix=1
module out    Finish volume=0.65 glue=0.3 ceiling=0.8

part drone "Hollow fifths" colour #7a4fb5 level=0.35
  module dseq   Dovetail steps_a=0.13 steps_b=0.07 interlock=0.3 chance=0.8 glide=0.5 range=0.2
  module dfret  Fret     root=0 scale=0.429 octave=0.375
  module dmit   Mitre    chord=0.923 inversion=0 spread=0.33 root=0
  module dsq1   Chisel   tune=0.5 fine=0.5 shape=0 pw=0.5
  module dsq2   Chisel   tune=0.5 fine=0.51 shape=0 pw=0.5
  module dsq3   Chisel   tune=0.5 fine=0.49 shape=0 pw=0.5
  module dsq4   Chisel   tune=0.5 fine=0.5 shape=0 pw=0.5
  module dflt   Plane    cutoff=0.38 res=0.3 mode=0 drive=0.1
  module dfltr  Plane    cutoff=0.42 res=0.3 mode=0 drive=0.1
  module breath Spokeshave rate=0.08 spread=0.6 shape=0 phase=0.3
  module spring Chatter  energy=0.5 tension=0.35 damping=0.5 rate=0.12 depth=0.6

part grains "Grain clouds" colour #3d9c8a level=0.8
  module cloud  Shavings size=0.7 density=0.35 spray=0.6 pitch=0.5
  module cloud2 Shavings size=0.5 density=0.5 spray=0.8 pitch=0.75

part bell "Distant bell" colour #d1a233 level=0.6
  module bmal   Mallet   material=0.8 size=0.7 strike=0.4 damp=0.2

cable tally1.bar -> dseq.clock
cable dseq.pitch -> dfret.pitch
cable dfret.pitch -> bmal.voct
cable dseq.gate -> bmal.trig
cable dflt.out -> cloud2.in
cable cloud.l -> room.in_l
cable cloud.r -> room.in_r
cable cloud2.l -> room.in_l
cable cloud2.r -> room.in_r
cable cloud.l -> mix.in4
cable cloud2.r -> mix.in5
cable bmal.out -> mix.in3
cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

cable dfret.pitch -> dmit.pitch
cable dmit.voice1 -> dsq1.voct
cable dmit.voice2 -> dsq2.voct
cable dmit.voice3 -> dsq3.voct
cable dmit.voice4 -> dsq4.voct
cable dsq1.square -> dflt.in
cable dsq3.square -> dflt.in
cable dsq2.square -> dfltr.in
cable dsq4.square -> dfltr.in
cable breath.lfo1 -> dflt.cutoff
cable spring.position -> dfltr.cutoff
cable dflt.out -> out.l
cable dfltr.out -> out.r
cable dflt.out -> room.in_l
cable dfltr.out -> room.in_r
cable dfltr.out -> cloud.in
scene A dflt.cutoff=0.25 cloud.density=0.25 cloud2.pitch=0.5 room.size=0.8
scene B dflt.cutoff=0.65 cloud.density=0.6 cloud2.pitch=0.75 room.size=0.95
