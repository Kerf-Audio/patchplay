kerf 1
tempo 118
key A dorian
tags four-four disco

module tally1 Tally tempo=0.5 swing=0.2 divide=0.5
module mix    Router level1=0.85 level2=0.7 level3=0.45 level4=0.55 level5=0.4 level6=0.55 send=0.3
module room   Kiln   size=0.6 heat=0.45 bloom=0.35 mix=1
module out    Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module beat     Ruler   hits_a=0.25 steps_a=1 hits_b=0.5 steps_b=1 hits_c=0 hits_d=0 chance=0.8
  module backbeat Ruler   hits_a=0.125 steps_a=1 hits_b=0.0625 steps_b=1 hits_c=0 hits_d=0 rotate=0.25 chance=0.5
  module offbeat  Ruler   hits_a=0.25 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0.125 chance=1
  module kick     Mortise engine=0 pitch=0.45 punch=0.55 decay=0.25 tone=0.5
  module snare    Mortise engine=0.25 pitch=0.55 punch=0.5 decay=0.35 tone=0.5
  module clap     Mortise engine=0.75 pitch=0.55 punch=0.5 decay=0.3 tone=0.55
  module ohat     Mortise engine=0.5 pitch=0.5 punch=0.4 decay=0.4 tone=0.7
  module chat     Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.08 tone=0.65
  module sample   Veneer  slice=0.34 speed=0.55 reverse=0 looped=0
  module duck     Bevel   attack=0 decay=0.3 sustain=0 release=0.3 curve=0.3

part bass "Octave bass" colour #3d63c9 level=0.85
  module bseq  Dovetail steps_a=0.2 steps_b=0.4 interlock=0.9 chance=0.95 glide=0 range=0.1
  module bfret Fret     root=0.75 scale=0.571 octave=0.375
  module bosc  Chisel   tune=0.5 shape=0.1 pw=0.5
  module benv  Bevel    attack=0 decay=0.25 sustain=0.35 release=0.15 curve=0.4
  module bflt  Plane    cutoff=0.45 res=0.25 mode=0 drive=0.2
  module bamp  Clamp    level=0 response=0.05
  module bduck Clamp    level=0 response=0

part strings "Strings" colour #7a4fb5 level=0.55
  module cseq  Dovetail steps_a=0.2 steps_b=0.067 interlock=0 chance=1 glide=0.1 range=0.3
  module cfret Fret     root=0.75 scale=0.571 octave=0.5
  module cply  Ply      layers=0.9 detune=0.3 width=1 tone=0.4
  module cflt  Plane    cutoff=0.5 res=0.15 mode=0 drive=0
  module cdrift Spokeshave rate=0.12 spread=0.5 shape=0 phase=0.25

part lick "Guitar lick" colour #d1a233 level=0.7
  module lseq   Dovetail steps_a=0.8 steps_b=0.6 interlock=0.9 chance=0.6 glide=0 range=0.25
  module lfret  Fret     root=0.75 scale=0.571 octave=0.625
  module losc   Chisel   tune=0.5 shape=0.3 pw=0.5
  module lamp   Clamp    level=0 response=0.8
  module lenv   Bevel    attack=0 decay=0.2 sustain=0 release=0.2 curve=0.3
  module lecho  Bandsaw  time=0.375 feedback=0.4 wear=0.35 mix=0.3

cable tally1.clock -> beat.clock
cable tally1.clock -> backbeat.clock
cable tally1.clock -> offbeat.clock
cable beat.a -> kick.trig
cable beat.a -> duck.gate
cable beat.b -> chat.trig
cable backbeat.a -> snare.trig
cable backbeat.a -> clap.trig
cable backbeat.b -> sample.trig
cable offbeat.a -> ohat.trig
cable kick.out -> mix.in1
cable snare.out -> mix.in4
cable clap.out -> mix.in4
cable sample.l -> mix.in4
cable sample.r -> mix.in4
cable ohat.out -> mix.in3
cable chat.out -> mix.in3

cable tally1.clock -> bseq.clock
cable bseq.pitch -> bfret.pitch
cable bfret.pitch -> bosc.voct
cable bseq.gate -> benv.gate
cable bosc.saw -> bflt.in
cable bflt.out -> bamp.in
cable benv.env -> bamp.cv
cable bamp.out -> bduck.in
cable duck.inverted -> bduck.cv
cable bduck.out -> mix.in2

cable tally1.bar -> cseq.clock
cable cseq.pitch -> cfret.pitch
cable cfret.pitch -> cply.voct
cable cply.l -> cflt.in
cable cply.r -> cflt.in
cable cdrift.lfo1 -> cflt.cutoff
cable cflt.out -> mix.in6

cable tally1.clock -> lseq.clock
cable lseq.pitch -> lfret.pitch
cable lfret.pitch -> losc.voct
cable lseq.gate -> lenv.gate
cable losc.square -> lamp.in
cable lenv.env -> lamp.cv
cable lamp.out -> lecho.in
cable tally1.clock -> lecho.clock
cable lecho.l -> mix.in5
cable lecho.r -> mix.in5

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A bflt.cutoff=0.4 cflt.cutoff=0.4 lseq.chance=0.4 chat.decay=0.06 cdrift.rate=0.1
scene B bflt.cutoff=0.7 cflt.cutoff=0.8 lseq.chance=0.8 chat.decay=0.14 cdrift.rate=0.4
