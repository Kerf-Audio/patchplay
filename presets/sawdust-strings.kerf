kerf 1
tempo 125
key C minor
tags four-four techno detroit

module tally1 Tally tempo=0.5 swing=0.04 divide=0.5
module mix    Router level1=0.8 level2=0.7 level3=0.35 level4=0.45 level5=0.7 level6=0.5 send=0.2
module room   Kiln   size=0.75 heat=0.5 bloom=0.45 mix=1
module out    Finish volume=0.7 glue=0.45 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.85
  module beat   Ruler   hits_a=0.25 steps_a=1 hits_b=0 hits_c=0 hits_d=0 chance=1
  module hats   Ruler   hits_a=0.25 steps_a=1 hits_b=0.2 steps_b=0.8 hits_c=0 hits_d=0 rotate=0.125 chance=0.4
  module snap   Ruler   hits_a=0.125 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0.25 chance=1
  module kick   Mortise engine=0 pitch=0.32 punch=0.7 decay=0.3 tone=0.35
  module hat    Mortise engine=0.5 pitch=0.6 punch=0.4 decay=0.18 tone=0.65
  module clap   Mortise engine=0.75 pitch=0.45 punch=0.6 decay=0.35 tone=0.5

part bass "Pulse bass" colour #3d63c9 level=0.8
  module bseq   Dovetail steps_a=0.2 steps_b=0.13 interlock=1 chance=0.9 glide=0.1 range=0.12
  module bfret  Fret     root=0 scale=0.429 octave=0.25
  module bosc   Chisel   tune=0.5 shape=0 pw=0.5
  module benv   Bevel    attack=0 decay=0.3 sustain=0.1 release=0.2 curve=0.3
  module bflt   Plane    cutoff=0.3 res=0.2 mode=0 drive=0.2
  module bamp   Clamp    level=0 response=0.1
  module squeeze Vise    squeeze=0.6 speed=0.7 makeup=0.35

part strings "Strings" colour #d1a233 level=0.7
  module chords Tread    step1=0.5 step2=0.62 step3=0.4 step4=0.7 step5=0.5 step6=0.3 step7=0.6 step8=0.45 length=0.29 direction=0 glide=0 rate=0.5 depth=0.15
  module cfret  Fret     root=0 scale=0.429 octave=0.5
  module cmit   Mitre    chord=0.692 inversion=0.33 spread=0.33 root=0
  module p1     Ply      layers=0.5 detune=0.3 width=0.8 tone=0.4
  module p2     Ply      layers=0.5 detune=0.35 width=0.8 tone=0.4
  module p3     Ply      layers=0.5 detune=0.4 width=0.8 tone=0.4
  module pflt   Plane    cutoff=0.5 res=0.2 mode=0 drive=0.1
  module sweep  Rocker   rate=0.3 sync=0.15 shape=0 depth=0.5 offset=0.5 phase=0
  module sdado  Dado     time=0.43 sync=1 feedback=0.45 tone=0.35 thin=0.3 wobble=0.35 drive=0.1 mix=0.4

cable tally1.clock -> beat.clock
cable tally1.clock -> hats.clock
cable tally1.clock -> snap.clock
cable beat.a -> kick.trig
cable hats.a -> hat.trig
cable hats.b -> hat.trig
cable snap.a -> clap.trig
cable kick.out -> mix.in1
cable hat.out -> mix.in3
cable clap.out -> mix.in4

cable tally1.clock -> bseq.clock
cable bseq.pitch -> bfret.pitch
cable bfret.pitch -> bosc.voct
cable bseq.gate -> benv.gate
cable bosc.square -> bflt.in
cable benv.env -> bflt.cutoff
cable bflt.out -> bamp.in
cable benv.env -> bamp.cv
cable bamp.out -> squeeze.in
cable kick.out -> squeeze.side
cable squeeze.out -> mix.in2

cable tally1.div4 -> chords.clock
cable chords.cv -> cfret.pitch
cable cfret.pitch -> cmit.pitch
cable cmit.voice1 -> p1.voct
cable cmit.voice2 -> p2.voct
cable cmit.voice3 -> p3.voct
cable p1.l -> pflt.in
cable p2.l -> pflt.in
cable p3.l -> pflt.in
cable sweep.out -> pflt.cutoff
cable pflt.out -> sdado.in_l
cable sdado.l -> mix.in5
cable sdado.r -> mix.in5

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A pflt.cutoff=0.4 sweep.depth=0.3 p1.detune=0.2 sdado.feedback=0.35
scene B pflt.cutoff=0.6 sweep.depth=0.8 p1.detune=0.5 sdado.feedback=0.6
