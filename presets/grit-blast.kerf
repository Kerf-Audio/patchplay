kerf 1
tempo 150
key F phrygian
tags noise techno

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.85 level2=0.65 level3=0.5 level4=0.6 level5=0.5 level6=0.6 send=0.3
module room Kiln size=0.6 heat=0.45 bloom=0.35 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.25 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.45 punch=0.7 decay=0.3 tone=0.5
  module r_clap Ruler hits_a=0.125 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.25
  module clap Mortise engine=0.75 pitch=0.55 punch=0.5 decay=0.25 tone=0.5
  module r_chat Ruler hits_a=0.5 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.125
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.06 tone=0.65
  module r_ohat Ruler hits_a=0.0625 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.875
  module ohat Mortise engine=0.5 pitch=0.5 punch=0.5 decay=0.4 tone=0.7
  module duck Bevel attack=0 decay=0.3 sustain=0 release=0.3 curve=0.3

part blast "Blast" colour #3da3a3 level=0.5
  module blastsrc Sawdust colour=0.7 crackle=0.3
  module blastflt Plane cutoff=0.5 res=0.55 mode=0.33 drive=0.1
  module blastamp Clamp level=0 response=0.4
  module blastrhy Ruler hits_a=0.5625 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0
  module blastenv Bevel attack=0.02 decay=0.3 sustain=0 release=0.25 curve=0.35
  module blastburl Burl rate=0.2 smooth=0.8 bias=0.5
  module blastlfo Spokeshave rate=0.25 spread=0.5 shape=0 phase=0.25

part bass "Grind" colour #3d63c9 level=0.7
  module bassseq Dovetail steps_a=1 steps_b=0.1333 interlock=0.8 chance=1 glide=0 range=0.1
  module bassfret Fret root=0.4167 scale=0.86 octave=0.25
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.2 sustain=0.3 release=0.1 curve=0.4
  module bassflt Plane cutoff=0.3 res=0.5 mode=0 drive=0.7
  module bassamp Clamp level=0 response=0.1
  module bassrasp Rasp drive=0.7 fold=0.5 bias=0.5 mix=0.8
  module bassduck Clamp level=0 response=0

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_clap.clock
cable r_clap.a -> clap.trig
cable clap.out -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.a -> chat.trig
cable chat.out -> mix.in3
cable clock.clock -> r_ohat.clock
cable r_ohat.a -> ohat.trig
cable ohat.out -> mix.in3
cable r_kick.a -> duck.gate

cable blastsrc.noise -> blastflt.in
cable blastflt.out -> blastamp.in
cable clock.clock -> blastrhy.clock
cable blastrhy.a -> blastenv.gate
cable blastenv.env -> blastamp.cv
cable blastamp.out -> mix.in6
cable blastburl.drift -> blastflt.cutoff
cable blastlfo.lfo1 -> blastflt.cutoff

cable clock.clock -> bassseq.clock
cable bassseq.pitch -> bassfret.pitch
cable bassfret.pitch -> bassosc.voct
cable bassseq.gate -> bassenv.gate
cable bassosc.saw -> bassflt.in
cable bassflt.out -> bassrasp.in
cable bassrasp.out -> bassamp.in
cable bassenv.env -> bassamp.cv
cable bassamp.out -> bassduck.in
cable duck.inverted -> bassduck.cv
cable bassduck.out -> mix.in2

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A blastflt.cutoff=0.38 bassflt.cutoff=0.18
scene B blastflt.cutoff=0.65 bassflt.cutoff=0.45
