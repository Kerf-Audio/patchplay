kerf 1
tempo 92
key C dorian
tags samples lofi

module clock Tally tempo=0.5 swing=0.3 divide=0.5
module mix Router level1=0.8 level2=0.7 level3=0.5 level4=0.6 level5=0.5 level6=0.4 send=0.3
module room Kiln size=0.5 heat=0.7 bloom=0.3 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.1875 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.4 punch=0.55 decay=0.3 tone=0.5
  module r_snare Ruler hits_a=0.125 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.25
  module snare Mortise engine=0.25 pitch=0.55 punch=0.5 decay=0.3 tone=0.45
  module r_chat Ruler hits_a=0 hits_b=0.5 hits_c=0 hits_d=0 steps_b=1 chance=0.9
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.06 tone=0.45
  module r_vox Ruler hits_a=0 hits_b=0.125 hits_c=0 hits_d=0 steps_b=1 rotate=0.625 chance=0.6
  module vox Veneer slice=0.8 speed=0.5 reverse=0 looped=0
  module r_loop Ruler hits_a=0 hits_b=0.25 hits_c=0 hits_d=0 steps_b=1 chance=0.8
  module loop Veneer slice=0.3 speed=0.45 reverse=0 looped=0

part bass "Bass" colour #3d63c9 level=0.85
  module bassseq Dovetail steps_a=1 steps_b=0.2667 interlock=0.4 chance=0.9 glide=0.2 range=0.15
  module bassfret Fret root=0 scale=0.57 octave=0.25
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.4 sustain=0.5 release=0.5 curve=0.4
  module bassflt Plane cutoff=0.3 res=0.2 mode=0 drive=0.1
  module bassamp Clamp level=0 response=0.1

part tex "Dust" colour #3da3a3 level=0.25
  module texsrc Sawdust colour=0.4 crackle=0.9
  module texflt Plane cutoff=0.5 res=0.1 mode=0 drive=0.1
  module texamp Clamp level=0.5 response=0.4

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_snare.clock
cable r_snare.a -> snare.trig
cable snare.out -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.b -> chat.trig
cable chat.out -> mix.in3
cable clock.clock -> r_vox.clock
cable r_vox.b -> vox.trig
cable vox.l -> mix.in4
cable vox.r -> mix.in4
cable clock.clock -> r_loop.clock
cable r_loop.b -> loop.trig
cable loop.l -> mix.in4
cable loop.r -> mix.in4

cable clock.clock -> bassseq.clock
cable bassseq.pitch -> bassfret.pitch
cable bassfret.pitch -> bassosc.voct
cable bassseq.gate -> bassenv.gate
cable bassosc.sine -> bassflt.in
cable bassflt.out -> bassamp.in
cable bassenv.env -> bassamp.cv
cable bassamp.out -> mix.in2

cable texsrc.dust -> texflt.in
cable texflt.out -> texamp.in
cable texamp.out -> mix.in6

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A bassflt.cutoff=0.18 texflt.cutoff=0.38
scene B bassflt.cutoff=0.45 texflt.cutoff=0.65
