kerf 1
tempo 72
key G minor
tags drone texture

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.7 level2=0.7 level3=0.5 level4=0.5 level5=0.5 level6=0.6 send=0.45
module room Kiln size=0.9 heat=0.5 bloom=0.6 mix=1
module out Finish volume=0.7 glue=0.3 ceiling=0.8

part drone "Beds" colour #7a4fb5 level=0.6
  module droneflt Plane cutoff=0.4 res=0.35 mode=0 drive=0.3
  module dronelfo Spokeshave rate=0.06 spread=0.6 shape=0 phase=0.25
  module droneo0 Chisel tune=0.1 fine=0.5 shape=0.4 pw=0.5
  module droneo1 Chisel tune=0.4 fine=0.53 shape=0.4 pw=0.5
  module droneo2 Chisel tune=0.6 fine=0.47 shape=0.4 pw=0.5
  module dronerasp Rasp drive=0.4 fold=0.5 bias=0.5 mix=0.6

part pad "Voices" colour #7a4fb5 level=0.7
  module padradio Static tune=0.35 width=0.3 hiss=0.3 crackle=0.05 whistle=0.45 fade=0.4 ghost=0.8 level=0.5
  module padflt Plane cutoff=0.45 res=0.55 mode=0.33 drive=0
  module padfltr Plane cutoff=0.38 res=0.55 mode=0.33 drive=0
  module padspring Chatter energy=0.5 tension=0.3 damping=0.45 rate=0.1 depth=0.5

cable droneo0.saw -> droneflt.in
cable droneo1.sub -> droneflt.in
cable droneo2.sine -> droneflt.in
cable dronelfo.lfo1 -> droneflt.cutoff
cable droneflt.out -> dronerasp.in
cable dronerasp.out -> mix.in6


cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

cable padradio.out -> padflt.in
cable padradio.out -> padfltr.in
cable padspring.position -> padradio.tune
cable padspring.velocity -> padfltr.cutoff
cable padspring.position -> padflt.cutoff
cable padflt.out -> out.l
cable padfltr.out -> out.r
cable padflt.out -> room.in_l
cable padfltr.out -> room.in_r
scene A droneflt.cutoff=0.28 padflt.cutoff=0.25
scene B droneflt.cutoff=0.58 padflt.cutoff=0.6
