kerf 1
tempo 140
key F# minor
tags dubstep dub

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.9 level2=0.8 level3=0.4 level4=0.7 level5=0.4 level6=0.5 send=0.3
module room Kiln size=0.5 heat=0.5 bloom=0.3 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.0625 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.4 punch=0.55 decay=0.4 tone=0.5
  module r_snare Ruler hits_a=0.0625 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.5
  module snare Mortise engine=0.25 pitch=0.5 punch=0.7 decay=0.4 tone=0.5
  module r_chat Ruler hits_a=0 hits_b=0.5 hits_c=0 hits_d=0 steps_b=1 chance=0.8
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.06 tone=0.65
  module r_ohat Ruler hits_a=0.0625 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.875
  module ohat Mortise engine=0.5 pitch=0.5 punch=0.5 decay=0.3 tone=0.7

part bass "Wob" colour #3d63c9 level=0.85
  module bassseq Dovetail steps_a=0.4667 steps_b=0.2667 interlock=0.5 chance=0.95 glide=0.3 range=0.2
  module bassfret Fret root=0.5 scale=0.43 octave=0.25
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.8 sustain=0.3 release=0.4 curve=0.4
  module bassflt Plane cutoff=0.3 res=0.6 mode=0 drive=0.5
  module bassamp Clamp level=0 response=0.1
  module bassrasp Rasp drive=0.5 fold=0.4 bias=0.5 mix=0.7
  module basslfo Rocker rate=0.72 sync=0 shape=0.15 depth=0.8 offset=0.5

part siren "Siren" colour #c9a23d level=0.35
  module sirrhy Ruler hits_a=0.0625 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0.9375
  module siren Siren pitch=0.6 range=0.6 rate=0.55 sync=0 shape=0 wave=0 release=0.35 cutoff=0.6 resonance=0.3 drive=0.2
cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_snare.clock
cable r_snare.a -> snare.trig
cable snare.out -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.b -> chat.trig
cable chat.out -> mix.in3
cable clock.clock -> r_ohat.clock
cable r_ohat.a -> ohat.trig
cable ohat.out -> mix.in3

cable clock.clock -> bassseq.clock
cable bassseq.pitch -> bassfret.pitch
cable bassfret.pitch -> bassosc.voct
cable bassseq.gate -> bassenv.gate
cable bassosc.saw -> bassflt.in
cable bassflt.out -> bassrasp.in
cable bassrasp.out -> bassamp.in
cable bassenv.env -> bassamp.cv
cable bassamp.out -> mix.in2
cable basslfo.out -> bassflt.cutoff

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

cable clock.clock -> sirrhy.clock
cable sirrhy.a -> siren.gate
cable siren.out -> mix.in6
scene A bassflt.cutoff=0.18
scene B bassflt.cutoff=0.45
