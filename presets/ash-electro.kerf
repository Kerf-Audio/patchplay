kerf 1
tempo 126
key E minor
tags four-four electro

module tally1 Tally tempo=0.5 swing=0.06 divide=0.5
module mix    Router level1=0.85 level2=0.7 level3=0.45 level4=0.6 level5=0.55 level6=0.5 send=0.25
module room   Kiln   size=0.4 heat=0.55 bloom=0.2 mix=1
module out    Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module beat   Ruler   hits_a=0.25 steps_a=1 hits_b=0.2 steps_b=0.867 hits_c=0 hits_d=0 chance=0.5
  module snares Ruler   hits_a=0.125 steps_a=1 hits_b=0.5 steps_b=0.8 hits_c=0 hits_d=0 rotate=0.25 chance=0.35
  module hats   Ruler   hits_a=0.5 steps_a=1 hits_b=0.8 steps_b=1 hits_c=0 hits_d=0 chance=0.45
  module kick   Mortise engine=0 pitch=0.4 punch=0.8 decay=0.28 tone=0.45
  module snare  Mortise engine=0.25 pitch=0.45 punch=0.7 decay=0.3 tone=0.55
  module ghost  Mortise engine=0.25 pitch=0.6 punch=0.5 decay=0.12 tone=0.6
  module hat    Mortise engine=0.5 pitch=0.55 punch=0.5 decay=0.1 tone=0.7
  module fizz   Mortise engine=0.5 pitch=0.75 punch=0.3 decay=0.06 tone=0.85
  module tom    Mortise engine=1 pitch=0.5 punch=0.6 decay=0.25 tone=0.5

part bass "Robot bass" colour #3d63c9 level=0.85
  module bseq  Dovetail steps_a=0.33 steps_b=0.2 interlock=0.7 chance=0.85 glide=0.2 range=0.15
  module bfret Fret     root=0.333 scale=0.429 octave=0.25
  module bosc  Chisel   tune=0.5 shape=0 pw=0.5
  module bwarp Rasp     drive=0.35 fold=0.25 bias=0.5 mix=0.6
  module benv  Bevel    attack=0 decay=0.35 sustain=0.1 release=0.2 curve=0.35
  module bflt  Plane    cutoff=0.4 res=0.45 mode=0 drive=0.3
  module bamp  Clamp    level=0 response=0.15
  module bduck Clamp    level=0 response=0
  module duck  Bevel    attack=0 decay=0.4 sustain=0 release=0.4 curve=0.3
  module macro Jig      m1=0.3 m2=0.5 m3=0.5 m4=0.5

part blips "Metal blips" colour #3d9c8a level=0.75
  module mseq   Dovetail steps_a=0.47 steps_b=0.27 interlock=0.6 chance=0.7 glide=0 range=0.35
  module mfret  Fret     root=0.333 scale=0.571 octave=0.625
  module mal    Mallet   material=0.7 size=0.35 strike=0.6 damp=0.55
  module mal2   Mallet   material=0.4 size=0.6 strike=0.5 damp=0.5
  module mdel   Bandsaw  time=0.375 feedback=0.45 wear=0.4 mix=0.35

cable tally1.clock -> beat.clock
cable tally1.clock -> snares.clock
cable tally1.clock -> hats.clock
cable beat.a -> kick.trig
cable beat.a -> duck.gate
cable beat.b -> tom.trig
cable snares.a -> snare.trig
cable snares.b -> ghost.trig
cable hats.a -> hat.trig
cable hats.b -> fizz.trig
cable kick.out -> mix.in1
cable snare.out -> mix.in4
cable ghost.out -> mix.in4
cable tom.out -> mix.in4
cable hat.out -> mix.in3
cable fizz.out -> mix.in3

cable tally1.clock -> bseq.clock
cable bseq.pitch -> bfret.pitch
cable bfret.pitch -> bosc.voct
cable bseq.gate -> benv.gate
cable bosc.square -> bwarp.in
cable bwarp.out -> bflt.in
cable macro.m1 -> bflt.cutoff
cable benv.env -> bflt.cutoff
cable bflt.out -> bamp.in
cable benv.env -> bamp.cv
cable bamp.out -> bduck.in
cable duck.inverted -> bduck.cv
cable bduck.out -> mix.in2

cable tally1.clock -> mseq.clock
cable mseq.pitch -> mfret.pitch
cable mfret.pitch -> mal.voct
cable mfret.pitch -> mal2.voct
cable mseq.gate -> mal.trig
cable mseq.gate -> mal2.trig
cable mal.out -> mdel.in
cable mal2.out -> mdel.in
cable tally1.clock -> mdel.clock
cable mdel.l -> mix.in5
cable mdel.r -> mix.in5

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A macro.m1=0.2 bwarp.fold=0.2 mal.material=0.7 mdel.feedback=0.4 hats.chance=0.35 mseq.chance=0.6
scene B macro.m1=0.55 bwarp.fold=0.6 mal.material=0.3 mdel.feedback=0.65 hats.chance=0.8 mseq.chance=0.9
