kerf 1
tempo 122
key F minor
tags four-four bleep bass

module tally1 Tally tempo=0.5 swing=0.06 divide=0.5
module mix    Router level1=0.8 level2=0.95 level3=0.3 level4=0.5 level5=0.6 level6=0.5 send=0.12
module room   Kiln   size=0.4 heat=0.6 bloom=0.2 mix=1
module out    Finish volume=0.7 glue=0.5 ceiling=0.8

part drums "Clicky drums" colour #c94a3d level=0.9
  module beat   Ruler   hits_a=0.25 steps_a=1 hits_b=0.2 steps_b=0.8 hits_c=0 hits_d=0 chance=0.3
  module snap   Ruler   hits_a=0.125 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0.25 chance=1
  module hats   Ruler   hits_a=0.25 steps_a=1 hits_b=0.3 steps_b=0.6 hits_c=0 hits_d=0 rotate=0.125 chance=0.5
  module kick   Mortise engine=0 pitch=0.3 punch=0.75 decay=0.3 tone=0.3
  module clap   Mortise engine=0.75 pitch=0.5 punch=0.8 decay=0.12 tone=0.6
  module clip   Rasp    drive=0.6 fold=0 bias=0.5 mix=0.7
  module hat    Mortise engine=0.5 pitch=0.7 punch=0.5 decay=0.04 tone=0.8

part sub "Sine sub" colour #3d63c9 level=0.9
  module bseq   Dovetail steps_a=0.2 steps_b=0.13 interlock=0.7 chance=0.85 glide=0.25 range=0.2
  module bfret  Fret     root=0.4167 scale=0.429 octave=0.25
  module bosc   Chisel   tune=0.5 shape=0 pw=0.5
  module benv   Bevel    attack=0.01 decay=0.4 sustain=0.5 release=0.2 curve=0.45
  module bamp   Clamp    level=0 response=0.05
  module squeeze Vise    squeeze=0.6 speed=0.6 makeup=0.35

part bleeps "Square bleeps" colour #d1a233 level=0.6
  module lrhy   Ruler   hits_a=0.4375 steps_a=1 hits_b=0 hits_c=0 hits_d=0 chance=1
  module tread  Tread   step1=0.5 step2=0.7 step3=0.4 step4=0.85 step5=0.3 step6=0.6 step7=0.75 step8=0.45 length=1 direction=0 glide=0 depth=0.25
  module lfret  Fret    root=0.4167 scale=0.143 octave=0.625
  module losc   Chisel  tune=0.5 shape=0 pw=0.5
  module lenv   Bevel   attack=0 decay=0.14 sustain=0 release=0.1 curve=0.3
  module lamp   Clamp   level=0 response=0.5
  module lflt   Plane   cutoff=0.7 res=0.35 mode=0 drive=0.2
  module lmod   Rocker  rate=0.3 sync=0.2 shape=0 depth=0.5 offset=0.5 phase=0
  module lecho  Dado    time=0.43 sync=1 feedback=0.4 tone=0.5 thin=0.3 wobble=0.2 drive=0.15 mix=0.3

cable tally1.clock -> beat.clock
cable tally1.clock -> snap.clock
cable tally1.clock -> hats.clock
cable beat.a -> kick.trig
cable beat.b -> kick.trig
cable snap.a -> clap.trig
cable hats.a -> hat.trig
cable hats.b -> hat.trig
cable kick.out -> mix.in1
cable clap.out -> clip.in
cable clip.out -> mix.in4
cable hat.out -> mix.in3

cable tally1.clock -> bseq.clock
cable bseq.pitch -> bfret.pitch
cable bfret.pitch -> bosc.voct
cable bseq.gate -> benv.gate
cable bosc.sine -> bamp.in
cable benv.env -> bamp.cv
cable bamp.out -> squeeze.in
cable kick.out -> squeeze.side
cable squeeze.out -> mix.in2

cable tally1.clock -> lrhy.clock
cable tally1.clock -> tread.clock
cable tread.cv -> lfret.pitch
cable lfret.pitch -> losc.voct
cable lrhy.a -> lenv.gate
cable losc.square -> lflt.in
cable lmod.out -> lflt.cutoff
cable lenv.env -> lflt.cutoff
cable lflt.out -> lamp.in
cable lenv.env -> lamp.cv
cable lamp.out -> lecho.in_l
cable lecho.l -> mix.in5
cable lecho.r -> mix.in5

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A lflt.cutoff=0.55 lmod.depth=0.3 lecho.feedback=0.3 beat.chance=0.2
scene B lflt.cutoff=0.8 lmod.depth=0.8 lecho.feedback=0.6 beat.chance=0.6
