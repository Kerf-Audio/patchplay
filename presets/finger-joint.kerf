  module lseq   Dovetail steps_a=1 steps_b=0.7 interlock=0.4 chance=0.8 glide=0.2 range=0.45
  module lfret  Fret     root=0.1667 scale=0.571 octave=0.5
  module losc   Lathe    tune=0.5 table=0.4 turn=0.4 warp=0.2
  module lturn  Rocker   rate=0.3 sync=0.3 shape=0 depth=0.7 offset=0.5 phase=0
  module lenv   Bevel    attack=0.01 decay=0.3 sustain=0.2 release=0.3 curve=0.4
