  module aseq  Dovetail steps_a=0.47 steps_b=0.33 interlock=0.4 chance=0.9 glide=0.25 range=0.25
  module afret Fret     root=0.583 scale=0.857 octave=0.25
  module aosc  Chisel   tune=0.5 shape=0 pw=0.5
  module aenv  Bevel    attack=0 decay=0.28 sustain=0 release=0.2 curve=0.3
  module awob  Burl     rate=0.3 smooth=0.8 bias=0.55
  module aflt  Plane    cutoff=0.3 res=0.7 mode=0 drive=0.45
  module abite Rasp     drive=0.45 fold=0.05 bias=0.5 mix=0.5
  module aamp  Clamp    level=0 response=0.1
  module aduck Clamp    level=0 response=0.0

part ping "Mallet hook" colour #3d9c8a level=0.7
  module pseq   Dovetail steps_a=0.8 steps_b=0.53 interlock=0.8 chance=0.55 glide=0 range=0.3
  module pfret  Fret     root=0.583 scale=0.857 octave=0.625
