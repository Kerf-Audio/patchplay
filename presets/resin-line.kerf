part drums "Drums" colour #c94a3d level=0.9
  module beat     Ruler   hits_a=0.25 steps_a=1 hits_b=0.75 steps_b=1 hits_c=0 hits_d=0 chance=0.5
  module backbeat Ruler   hits_a=0.125 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0.25 chance=1
  module offbeat  Ruler   hits_a=0.25 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0.125 chance=1
  module kick     Mortise engine=0 pitch=0.38 punch=0.7 decay=0.3 tone=0.4
