  module dust   Sawdust colour=0.8 crackle=0.2
  module dflt   Plane   cutoff=0.75 res=0.2 mode=0.667 drive=0
  module denv   Bevel   attack=0 decay=0.3 sustain=0.3 release=0.3 curve=0.2
  module damp   Clamp   level=0 response=0

