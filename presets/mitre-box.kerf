  module bassseq Dovetail steps_a=1 steps_b=0.2667 interlock=0.5 chance=0.9 glide=0.2 range=0.15
  module bassfret Fret root=0.75 scale=0.43 octave=0.25
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.5 sustain=0.6 release=0.2 curve=0.4
  module bassflt Plane cutoff=0.35 res=0.2 mode=0 drive=0.15
