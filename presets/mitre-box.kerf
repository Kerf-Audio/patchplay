  module r_ghost Ruler hits_a=0 hits_b=0.1875 hits_c=0 hits_d=0 steps_b=1 rotate=0.4375 chance=0.6
  module ghost Mortise engine=0.25 pitch=0.55 punch=0.3 decay=0.12 tone=0.5
  module r_chat Ruler hits_a=0 hits_b=1 hits_c=0 hits_d=0 steps_b=1 chance=0.7
