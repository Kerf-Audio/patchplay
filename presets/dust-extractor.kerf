  module chordseq Dovetail steps_a=0.4667 steps_b=0.2667 interlock=0.5 chance=0.6 glide=0 range=0.15
  module chordfret Fret root=0.75 scale=0.57 octave=0.375
  module chordosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module chordenv Bevel attack=0 decay=0.05 sustain=0 release=0.2 curve=0.4
  module chordflt Plane cutoff=0.4 res=0.2 mode=0 drive=0.08
  module chordamp Clamp level=0 response=0.5
  module chordecho Dado time=0.43 sync=1 feedback=0.78 tone=0.5 thin=0.3 wobble=0.45 drive=0.3 mix=1
  module chrock Rocker rate=0.3 shape=0.1 depth=0.8 offset=0.5

