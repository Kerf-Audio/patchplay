kerf 1
tempo 122
key A dorian
tags dub techno

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.8 level2=0.65 level3=0.4 level4=0.5 level5=0.6 level6=0.4 send=0.5
module room Kiln size=0.9 heat=0.6 bloom=0.6 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.25 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.4 punch=0.55 decay=0.35 tone=0.5
  module r_ohat Ruler hits_a=0.25 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.125
  module ohat Mortise engine=0.5 pitch=0.5 punch=0.5 decay=0.2 tone=0.5
  module r_clap Ruler hits_a=0.125 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.25
  module clap Mortise engine=0.75 pitch=0.5 punch=0.5 decay=0.3 tone=0.5

