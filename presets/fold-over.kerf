kerf 1
tempo 128
key G minor
tags fold techno

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.85 level2=0.75 level3=0.5 level4=0.6 level5=0.5 level6=0.5 send=0.3
module room Kiln size=0.6 heat=0.45 bloom=0.35 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.25 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.45 punch=0.55 decay=0.25 tone=0.5
  module r_clap Ruler hits_a=0.125 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.25
  module clap Mortise engine=0.75 pitch=0.55 punch=0.5 decay=0.28 tone=0.5
  module r_chat Ruler hits_a=0.5 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.125
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.07 tone=0.65

part fold "Folded" colour #d1a233 level=0.7
  module foldseq Dovetail steps_a=1 steps_b=0.2667 interlock=0.5 chance=0.9 glide=0.1 range=0.4
  module foldfret Fret root=0.5833 scale=0.43 octave=0.375
  module foldosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module foldenv Bevel attack=0 decay=0.2 sustain=0.1 release=0.2 curve=0.4
  module foldflt Plane cutoff=0.45 res=0.4 mode=0 drive=0.3
  module foldamp Clamp level=0 response=0.5
  module foldrasp Rasp drive=0.4 fold=0.9 bias=0.5 mix=1
  module foldlfo Spokeshave rate=0.2 spread=0.5 shape=0 phase=0.25

part bass "Sub" colour #3d63c9 level=0.85
  module bassseq Dovetail steps_a=1 steps_b=0.1333 interlock=0.3 chance=1 glide=0.1 range=0.1
  module bassfret Fret root=0.5833 scale=0.43 octave=0.25
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.4 sustain=0.6 release=0.5 curve=0.4
  module bassflt Plane cutoff=0.3 res=0.2 mode=0 drive=0.1
  module bassamp Clamp level=0 response=0.1

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_clap.clock
cable r_clap.a -> clap.trig
cable clap.out -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.a -> chat.trig
cable chat.out -> mix.in3

cable clock.clock -> foldseq.clock
cable foldseq.pitch -> foldfret.pitch
cable foldfret.pitch -> foldosc.voct
cable foldseq.gate -> foldenv.gate
cable foldosc.saw -> foldflt.in
cable foldflt.out -> foldrasp.in
cable foldrasp.out -> foldamp.in
cable foldenv.env -> foldamp.cv
cable foldamp.out -> mix.in2
cable foldlfo.lfo1 -> foldflt.cutoff

cable clock.clock -> bassseq.clock
cable bassseq.pitch -> bassfret.pitch
cable bassfret.pitch -> bassosc.voct
cable bassseq.gate -> bassenv.gate
cable bassosc.sine -> bassflt.in
cable bassflt.out -> bassamp.in
cable bassenv.env -> bassamp.cv
cable bassamp.out -> mix.in2

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A foldflt.cutoff=0.33 bassflt.cutoff=0.18
scene B foldflt.cutoff=0.6 bassflt.cutoff=0.45
