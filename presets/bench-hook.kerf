kerf 1
tempo 140
key C phrygian
tags dubstep dub minimal

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.9 level2=0.85 level3=0.4 level4=0.6 level5=0.4 level6=1 send=0.4
module room Kiln size=0.65 heat=0.55 bloom=0.4 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.0625 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.35 punch=0.55 decay=0.45 tone=0.5
  module r_kick2 Ruler hits_a=0 hits_b=0.0625 hits_c=0 hits_d=0 steps_b=1 rotate=0.4375 chance=0.5
  module kick2 Mortise engine=0 pitch=0.35 punch=0.55 decay=0.3 tone=0.5
  module r_clap Ruler hits_a=0.0625 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.5
  module clap Mortise engine=0.75 pitch=0.55 punch=0.5 decay=0.35 tone=0.5
  module r_chat Ruler hits_a=0 hits_b=0.25 hits_c=0 hits_d=0 steps_b=1 rotate=0.125 chance=0.7
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.1 tone=0.65

part bass "Pressure" colour #3d63c9 level=0.85
  module bassseq Dovetail steps_a=1 steps_b=0.1333 interlock=0.3 chance=0.9 glide=0.4 range=0.15
  module bassfret Fret root=0 scale=0.86 octave=0.25
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.7 sustain=0.75 release=0.5 curve=0.4
  module bassflt Plane cutoff=0.25 res=0.3 mode=0 drive=0.1
  module bassamp Clamp level=0 response=0.1

part stab "Chord" colour #d1a233 level=0.4
  module stabseq Dovetail steps_a=0.2 steps_b=0.2667 interlock=0.6 chance=0.6 glide=0.1 range=0.2
  module stabfret Fret root=0 scale=0.86 octave=0.375
  module stabosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module stabenv Bevel attack=0 decay=0.15 sustain=0.1 release=0.5 curve=0.4
  module stabflt Plane cutoff=0.35 res=0.4 mode=0 drive=0.15
  module stabamp Clamp level=0 response=0.5
  module stabecho Dado time=0.43 sync=1 feedback=0.65 tone=0.4 thin=0.35 wobble=0.3 drive=0.3 mix=1

part siren "Siren" colour #c9a23d level=0.9
  module sirrhy Ruler hits_a=0.125 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0.8125
  module siren Siren pitch=0.55 range=0.5 rate=0.55 sync=0 shape=0 wave=0 release=0.55 cutoff=0.7 resonance=0.3 drive=0.2
cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_kick2.clock
cable r_kick2.b -> kick2.trig
cable kick2.out -> mix.in1
cable clock.clock -> r_clap.clock
cable r_clap.a -> clap.trig
cable clap.out -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.b -> chat.trig
cable chat.out -> mix.in3

cable clock.clock -> bassseq.clock
cable bassseq.pitch -> bassfret.pitch
cable bassfret.pitch -> bassosc.voct
cable bassseq.gate -> bassenv.gate
cable bassosc.sine -> bassflt.in
cable bassflt.out -> bassamp.in
cable bassenv.env -> bassamp.cv
cable bassamp.out -> mix.in2

cable clock.clock -> stabseq.clock
cable stabseq.pitch -> stabfret.pitch
cable stabfret.pitch -> stabosc.voct
cable stabseq.gate -> stabenv.gate
cable stabosc.square -> stabflt.in
cable stabflt.out -> stabamp.in
cable stabenv.env -> stabamp.cv
cable stabamp.out -> mix.in5
cable stabamp.out -> stabecho.in_l
cable stabecho.l -> mix.in5
cable stabecho.r -> mix.in5

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

cable clock.clock -> sirrhy.clock
cable sirrhy.a -> siren.gate
cable siren.out -> mix.in6
cable siren.out -> stabecho.in_r
scene A bassflt.cutoff=0.13 stabflt.cutoff=0.23
scene B bassflt.cutoff=0.4 stabflt.cutoff=0.5
