kerf 1
tempo 108
key G mixolydian
tags disco four-four

module clock Tally tempo=0.5 swing=0.2 divide=0.5
module mix Router level1=0.85 level2=0.7 level3=0.5 level4=0.6 level5=0.5 level6=0.5 send=0.3
module room Kiln size=0.6 heat=0.45 bloom=0.35 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.25 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.45 punch=0.55 decay=0.27 tone=0.5
  module r_snare Ruler hits_a=0.125 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.25
  module snare Mortise engine=0.25 pitch=0.55 punch=0.5 decay=0.3 tone=0.5
  module r_chat Ruler hits_a=0 hits_b=1 hits_c=0 hits_d=0 steps_b=1 chance=0.85
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.05 tone=0.65
  module r_ohat Ruler hits_a=0.125 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.375
  module ohat Mortise engine=0.5 pitch=0.5 punch=0.5 decay=0.25 tone=0.7

part bass "Slap" colour #3d63c9 level=0.85
  module bassseq Dovetail steps_a=1 steps_b=0.6667 interlock=0.6 chance=0.9 glide=0 range=0.3
  module bassfret Fret root=0.5833 scale=0.71 octave=0.25
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.15 sustain=0.1 release=0.2 curve=0.4
  module bassflt Plane cutoff=0.4 res=0.35 mode=0 drive=0.2
  module bassamp Clamp level=0 response=0.1

part keys "Clav" colour #d1a233 level=0.4
  module keysseq Dovetail steps_a=1 steps_b=0.2667 interlock=0.5 chance=0.7 glide=0 range=0.3
  module keysfret Fret root=0.5833 scale=0.71 octave=0.5
  module keysosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module keysenv Bevel attack=0 decay=0.1 sustain=0 release=0.2 curve=0.4
  module keysflt Plane cutoff=0.55 res=0.3 mode=0 drive=0.15
  module keysamp Clamp level=0 response=0.5
  module keysecho Bandsaw time=0.375 feedback=0.35 wear=0.35 mix=1

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_snare.clock
cable r_snare.a -> snare.trig
cable snare.out -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.b -> chat.trig
cable chat.out -> mix.in3
cable clock.clock -> r_ohat.clock
cable r_ohat.a -> ohat.trig
cable ohat.out -> mix.in3

cable clock.clock -> bassseq.clock
cable bassseq.pitch -> bassfret.pitch
cable bassfret.pitch -> bassosc.voct
cable bassseq.gate -> bassenv.gate
cable bassosc.square -> bassflt.in
cable bassflt.out -> bassamp.in
cable bassenv.env -> bassamp.cv
cable bassamp.out -> mix.in2

cable clock.clock -> keysseq.clock
cable keysseq.pitch -> keysfret.pitch
cable keysfret.pitch -> keysosc.voct
cable keysseq.gate -> keysenv.gate
cable keysosc.square -> keysflt.in
cable keysflt.out -> keysamp.in
cable keysenv.env -> keysamp.cv
cable keysamp.out -> mix.in5
cable clock.clock -> keysecho.clock
cable keysamp.out -> keysecho.in
cable keysecho.l -> mix.in5
cable keysecho.r -> mix.in5

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A bassflt.cutoff=0.28 keysflt.cutoff=0.43
scene B bassflt.cutoff=0.55 keysflt.cutoff=0.7
