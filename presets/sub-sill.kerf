kerf 1
tempo 120
key G minor
tags four-four bleep bass

module tally1 Tally tempo=0.5 swing=0.05 divide=0.5
module mix    Router level1=0.7 level2=1 level3=0.3 level4=0.5 level5=0.5 level6=0.45 send=0.1
module room   Kiln   size=0.45 heat=0.6 bloom=0.2 mix=1
module out    Finish volume=0.7 glue=0.5 ceiling=0.8

part drums "Sparse drums" colour #c94a3d level=0.85
  module beat   Ruler   hits_a=0.125 steps_a=1 hits_b=0.25 steps_b=0.867 hits_c=0 hits_d=0 chance=0.5
  module snap   Ruler   hits_a=0.0625 steps_a=1 hits_b=0.1 steps_b=0.8 hits_c=0 hits_d=0 rotate=0.5 chance=0.5
  module hats   Ruler   hits_a=0.25 steps_a=1 hits_b=0.25 steps_b=0.4 hits_c=0 hits_d=0 rotate=0.125 chance=0.45
  module kick   Mortise engine=0 pitch=0.25 punch=0.6 decay=0.4 tone=0.25
  module clap   Mortise engine=0.75 pitch=0.5 punch=0.8 decay=0.1 tone=0.6
  module hat    Mortise engine=0.5 pitch=0.7 punch=0.5 decay=0.03 tone=0.8

part sub "Big sub" colour #3d63c9 level=0.95
  module bseq   Dovetail steps_a=0.27 steps_b=0.13 interlock=1 chance=0.95 glide=0.35 range=0.15
  module bfret  Fret     root=0.583 scale=0.143 octave=0.25
  module bosc   Chisel   tune=0.5 shape=0 pw=0.5
  module benv   Bevel    attack=0.01 decay=0.5 sustain=0.6 release=0.25 curve=0.5
  module bgrit  Splice   mode=0 amount=0.25 coarse=0.5 fine=0.5 mix=0.35 level=0.5
  module bamp   Clamp    level=0 response=0.05
  module squeeze Vise    squeeze=0.7 speed=0.6 makeup=0.4

part tops "Bleep tops" colour #d1a233 level=0.45
  module lrhy   Ruler   hits_a=0.1875 steps_a=1 hits_b=0 hits_c=0 hits_d=0 chance=1
  module lseq   Dovetail steps_a=0.27 steps_b=0.2 interlock=0 chance=1 glide=0 range=0.3
  module lfret  Fret    root=0.583 scale=0.143 octave=0.625
  module losc   Chisel  tune=0.5 shape=0 pw=0.5
  module lenv   Bevel   attack=0 decay=0.12 sustain=0 release=0.08 curve=0.3
  module lamp   Clamp   level=0 response=0.5
  module lwarp  Warp    amount=0.05 speed=0.2 rough=0.1 chaos=0.1
  module lecho  Dado    time=0.43 sync=1 feedback=0.5 tone=0.4 thin=0.35 wobble=0.25 drive=0.15 mix=0.35
  module wob    Rocker  rate=0.15 sync=0.2 shape=0 depth=0.6 offset=0.5 phase=0
  module sflt   Plane   cutoff=0.8 res=0.3 mode=0 drive=0.1

cable tally1.clock -> beat.clock
cable tally1.clock -> snap.clock
cable tally1.clock -> hats.clock
cable beat.a -> kick.trig
cable beat.b -> kick.trig
cable snap.a -> clap.trig
cable snap.b -> clap.trig
cable hats.a -> hat.trig
cable hats.b -> hat.trig
cable kick.out -> mix.in1
cable clap.out -> mix.in4
cable hat.out -> mix.in3

cable tally1.clock -> bseq.clock
cable bseq.pitch -> bfret.pitch
cable bfret.pitch -> bosc.voct
cable bseq.gate -> benv.gate
cable bosc.sine -> bgrit.carrier
cable bgrit.out -> bamp.in
cable benv.env -> bamp.cv
cable bamp.out -> squeeze.in
cable kick.out -> squeeze.side
cable squeeze.out -> mix.in2

cable tally1.clock -> lrhy.clock
cable tally1.clock -> lseq.clock
cable lseq.pitch -> lwarp.in
cable lwarp.out -> lfret.pitch
cable lfret.pitch -> losc.voct
cable lrhy.a -> lenv.gate
cable losc.square -> sflt.in
cable wob.out -> sflt.cutoff
cable sflt.out -> lamp.in
cable lenv.env -> lamp.cv
cable lamp.out -> lecho.in_l
cable lecho.l -> mix.in5
cable lecho.r -> mix.in5

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A bgrit.amount=0.15 benv.sustain=0.4 wob.depth=0.3 lecho.feedback=0.3
scene B bgrit.amount=0.5 benv.sustain=0.75 wob.depth=0.9 lecho.feedback=0.65
