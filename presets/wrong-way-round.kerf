kerf 1
tempo 144
key F# phrygian
tags crazy chance glitch

module clock Tally tempo=0.5 swing=0.2 divide=0.5
module mix Router level1=0.85 level2=0.7 level3=0.5 level4=0.6 level5=0.5 level6=0.5 send=0.3
module room Kiln size=0.6 heat=0.45 bloom=0.35 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.4286 hits_b=0 hits_c=0 hits_d=0 steps_a=0.4
  module kick Mortise engine=0 pitch=0.45 punch=0.55 decay=0.3 tone=0.5
  module r_snare Ruler hits_a=0.2222 hits_b=0 hits_c=0 hits_d=0 steps_a=0.5333 rotate=0.1111
  module snare Mortise engine=0.25 pitch=0.55 punch=0.5 decay=0.25 tone=0.5
  module r_chat Ruler hits_a=0.8462 hits_b=0 hits_c=0 hits_d=0 steps_a=0.8
  module chat Mortise engine=0.5 pitch=0.7 punch=0.5 decay=0.05 tone=0.65
  module r_tom Ruler hits_a=0 hits_b=0.4 hits_c=0 hits_d=0 steps_b=0.2667 chance=0.7
  module tom Mortise engine=1 pitch=0.4 punch=0.5 decay=0.3 tone=0.5
  module tom_coin Burl rate=0.4 smooth=0.5 bias=0.5
  module r_rev Ruler hits_a=0 hits_b=0.2727 hits_c=0 hits_d=0 steps_b=0.6667 rotate=0.1818 chance=0.7
  module rev Veneer slice=0.3 speed=0.4 reverse=1 looped=0

part bass "Backwards" colour #3d63c9 level=0.85
  module bassseq Dovetail steps_a=0.6667 steps_b=0.8 interlock=0.4 chance=0.8 glide=0.6 range=0.6
  module bassfret Fret root=0.5 scale=0.86 octave=0.375
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.3 sustain=0.2 release=0.2 curve=0.4
  module bassflt Plane cutoff=0.35 res=0.5 mode=0 drive=0.3
  module bassamp Clamp level=0 response=0.1
  module bassrasp Rasp drive=0.5 fold=0.6 bias=0.5 mix=0.8
  module bassburl Burl rate=0.25 smooth=0.7 bias=0.5

part pad "Fog" colour #7a4fb5 level=0.4
  module padseq Dovetail steps_a=0.4 steps_b=0.0667 interlock=0 chance=0.5 glide=0.1 range=0.3
  module padfret Fret root=0.5 scale=0.86 octave=0.5
  module padply Ply layers=0.9 detune=0.7 width=1 tone=0.5
  module padflt Plane cutoff=0.5 res=0.15 mode=0 drive=0
  module paddrift Spokeshave rate=0.12 spread=0.5 shape=0 phase=0.25

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_snare.clock
cable r_snare.a -> snare.trig
cable snare.out -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.a -> chat.trig
cable chat.out -> mix.in3
cable r_tom.b -> tom_coin.trig
cable clock.clock -> r_tom.clock
cable tom_coin.coin -> tom.trig
cable tom.out -> mix.in4
cable clock.clock -> r_rev.clock
cable r_rev.b -> rev.trig
cable rev.l -> mix.in4
cable rev.r -> mix.in4

cable clock.clock -> bassseq.clock
cable bassseq.pitch -> bassfret.pitch
cable bassfret.pitch -> bassosc.voct
cable bassseq.gate -> bassenv.gate
cable bassosc.square -> bassflt.in
cable bassflt.out -> bassrasp.in
cable bassrasp.out -> bassamp.in
cable bassenv.env -> bassamp.cv
cable bassamp.out -> mix.in2
cable bassburl.drift -> bassflt.cutoff

cable clock.clock -> padseq.clock
cable padseq.pitch -> padfret.pitch
cable padfret.pitch -> padply.voct
cable padply.l -> padflt.in
cable padply.r -> padflt.in
cable paddrift.lfo1 -> padflt.cutoff
cable padflt.out -> mix.in6

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A bassflt.cutoff=0.23 padflt.cutoff=0.35
scene B bassflt.cutoff=0.5 padflt.cutoff=0.7
