  module trw    Ruler    hits_a=0.0625 steps_a=1 hits_b=0 hits_c=0 hits_d=0 chance=1
  module sseq   Dovetail steps_a=0.2 steps_b=0.13 interlock=0 chance=1 glide=0 range=0.12
