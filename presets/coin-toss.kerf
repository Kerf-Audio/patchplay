kerf 1
tempo 110
key D mixolydian
tags chance generative

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.85 level2=0.7 level3=0.5 level4=0.6 level5=0.5 level6=0.5 send=0.3
module room Kiln size=0.6 heat=0.45 bloom=0.35 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.25 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.45 punch=0.55 decay=0.28 tone=0.5
  module r_snare Ruler hits_a=0 hits_b=0.125 hits_c=0 hits_d=0 steps_b=1 rotate=0.25 chance=0.7
  module snare Mortise engine=0.25 pitch=0.55 punch=0.5 decay=0.3 tone=0.5
  module r_chat Ruler hits_a=0 hits_b=1 hits_c=0 hits_d=0 steps_b=1 chance=0.5
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.05 tone=0.65
  module chat_coin Burl rate=0.4 smooth=0.5 bias=0.5
  module r_tom Ruler hits_a=0 hits_b=0.3125 hits_c=0 hits_d=0 steps_b=1 chance=0.5
  module tom Mortise engine=1 pitch=0.35 punch=0.5 decay=0.3 tone=0.5
  module tom_coin Burl rate=0.4 smooth=0.5 bias=0.5

part bass "Walk" colour #3d63c9 level=0.85
  module bassseq Dovetail steps_a=1 steps_b=0.4 interlock=0.6 chance=0.6 glide=0.2 range=0.3
  module bassfret Fret root=0.1667 scale=0.71 octave=0.25
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.3 sustain=0.3 release=0.2 curve=0.4
  module bassflt Plane cutoff=0.38 res=0.3 mode=0 drive=0.2
  module bassamp Clamp level=0 response=0.1
  module bassburl Burl rate=0.25 smooth=0.7 bias=0.5

part lead "Wander" colour #d1a233 level=0.5
  module leadseq Dovetail steps_a=0.8 steps_b=0.2667 interlock=0.6 chance=0.5 glide=0.3 range=0.5
  module leadfret Fret root=0.1667 scale=0.71 octave=0.5
  module leadosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module leadenv Bevel attack=0 decay=0.4 sustain=0.3 release=0.3 curve=0.4
  module leadflt Plane cutoff=0.5 res=0.2 mode=0 drive=0.15
  module leadamp Clamp level=0 response=0.5
  module leadecho Bandsaw time=0.375 feedback=0.5 wear=0.35 mix=1
  module leadburl Burl rate=0.25 smooth=0.7 bias=0.5

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_snare.clock
cable r_snare.b -> snare.trig
cable snare.out -> mix.in4
cable r_chat.b -> chat_coin.trig
cable clock.clock -> r_chat.clock
cable chat_coin.coin -> chat.trig
cable chat.out -> mix.in3
cable r_tom.b -> tom_coin.trig
cable clock.clock -> r_tom.clock
cable tom_coin.coin -> tom.trig
cable tom.out -> mix.in4

cable clock.clock -> bassseq.clock
cable bassseq.pitch -> bassfret.pitch
cable bassfret.pitch -> bassosc.voct
cable bassseq.gate -> bassenv.gate
cable bassosc.square -> bassflt.in
cable bassflt.out -> bassamp.in
cable bassenv.env -> bassamp.cv
cable bassamp.out -> mix.in2
cable bassburl.drift -> bassflt.cutoff

cable clock.clock -> leadseq.clock
cable leadseq.pitch -> leadfret.pitch
cable leadfret.pitch -> leadosc.voct
cable leadseq.gate -> leadenv.gate
cable leadosc.sine -> leadflt.in
cable leadflt.out -> leadamp.in
cable leadenv.env -> leadamp.cv
cable leadamp.out -> mix.in5
cable clock.clock -> leadecho.clock
cable leadamp.out -> leadecho.in
cable leadecho.l -> mix.in5
cable leadecho.r -> mix.in5
cable leadburl.drift -> leadflt.cutoff

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A bassflt.cutoff=0.26 leadflt.cutoff=0.38
scene B bassflt.cutoff=0.53 leadflt.cutoff=0.65
