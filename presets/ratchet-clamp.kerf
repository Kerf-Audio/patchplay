kerf 1
tempo 112
key A minor
tags four-four granular stutter

module clock Tally tempo=0.5 swing=0.12 divide=0.5
module mix Router level1=0.7 level2=0.5 level3=0.5 level4=0.5 level5=0.5 level6=0.5 send=0.3
module room Kiln size=0.4 heat=0.5 bloom=0.2 mix=1
module out Finish volume=0.55 glue=0.4 ceiling=0.8

part stut "Stutter" colour #b5527a level=1
  module strl Ruler hits_a=0.4375 hits_b=0.1875 hits_c=0 hits_d=0 steps_a=1 steps_b=0.8 rotate=0 chance=0.85
  module sttr Tread step1=0.385 step2=0.26 step3=0.51 step4=0.76 step5=0.135 step6=0.64 step7=0.385 step8=0.89 length=1 direction=0.75 glide=0 depth=1
  module stsp Splinter position=0.5 spray=0.02 size=0.35 density=1 pitch=0.5 scatter=0.1 reverse=0.2 shape=0.5 spread=0.6 level=0.85 hold=0

part flick "Flicks" colour #d1a233 level=0.7
  module flsp Splinter position=0.82 spray=0.03 size=0.3 density=1 pitch=0.6 scatter=0.05 reverse=0.4 shape=0.7 spread=0.9 level=0.8 hold=0
  module flflt Plane cutoff=0.6 res=0.2 mode=0.67 drive=0

part kick "Kick" colour #c94a3d level=0.6
  module kickrl Ruler hits_a=0.25 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.4 punch=0.5 decay=0.35 tone=0.4

cable clock.clock -> strl.clock
cable strl.a -> sttr.clock
cable strl.a -> stsp.trig
cable sttr.cv -> stsp.position
cable strl.b -> flsp.trig
cable stsp.l -> out.l
cable stsp.r -> out.r
cable stsp.l -> room.in_l
cable stsp.r -> room.in_r
cable flsp.l -> flflt.in
cable flsp.r -> flflt.in
cable flflt.out -> out.l
cable flflt.out -> out.r
cable flflt.out -> room.in_l
cable flflt.out -> room.in_r
cable clock.clock -> kickrl.clock
cable kickrl.a -> kick.trig
cable kick.out -> mix.in1
cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A stsp.size=0.3 stsp.scatter=0.05 flsp.size=0.2
scene B stsp.size=0.55 stsp.scatter=0.3 flsp.size=0.45
