kerf 1
tempo 140
key A minor pentatonic
tags glitch chance

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.85 level2=0.7 level3=0.5 level4=0.6 level5=0.5 level6=0.5 send=0.3
module room Kiln size=0.6 heat=0.45 bloom=0.35 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.25 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.45 punch=0.55 decay=0.22 tone=0.5
  module r_clap Ruler hits_a=0.2857 hits_b=0 hits_c=0 hits_d=0 steps_a=0.4 rotate=0.2857
  module clap Mortise engine=0.75 pitch=0.55 punch=0.5 decay=0.2 tone=0.5
  module r_chat Ruler hits_a=0.8182 hits_b=0 hits_c=0 hits_d=0 steps_a=0.6667
  module chat Mortise engine=0.5 pitch=0.7 punch=0.5 decay=0.04 tone=0.65
  module r_cut Ruler hits_a=0 hits_b=0.4545 hits_c=0 hits_d=0 steps_b=0.6667 chance=0.6
  module cut Veneer slice=0.45 speed=0.6 reverse=0.7 looped=0
  module r_tom Ruler hits_a=0 hits_b=0.6 hits_c=0 hits_d=0 steps_b=0.2667 chance=0.5
  module tom Mortise engine=1 pitch=0.6 punch=0.5 decay=0.2 tone=0.5
  module tom_coin Burl rate=0.4 smooth=0.5 bias=0.5

part mal "Click" colour #3da36b level=0.7
  module malseq Dovetail steps_a=0.4 steps_b=0.2667 interlock=0.3 chance=0.6 glide=0 range=0.6
  module malfret Fret root=0.75 scale=0.14 octave=0.625
  module malmal Mallet material=0.45 size=0.2 strike=0.8 damp=0.7
  module malecho Bandsaw time=0.375 feedback=0.6 wear=0.4 mix=1
  module jolt Chatter energy=0.6 tension=0.5 damping=0.35 rate=0.4 depth=0.5
  module wob Warp amount=0.3 speed=0.4 rough=0.4 chaos=0.5

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_clap.clock
cable r_clap.a -> clap.trig
cable clap.out -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.a -> chat.trig
cable chat.out -> mix.in3
cable clock.clock -> r_cut.clock
cable r_cut.b -> cut.trig
cable cut.l -> mix.in4
cable cut.r -> mix.in4
cable r_tom.b -> tom_coin.trig
cable clock.clock -> r_tom.clock
cable tom_coin.coin -> tom.trig
cable tom.out -> mix.in4

cable clock.clock -> malseq.clock
cable malseq.pitch -> malfret.pitch
cable malfret.pitch -> malmal.voct
cable malseq.gate -> malmal.trig
cable malmal.out -> mix.in5
cable clock.clock -> malecho.clock
cable malmal.out -> malecho.in
cable malecho.l -> mix.in5
cable malecho.r -> mix.in5

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

cable r_cut.b -> jolt.kick
cable jolt.position -> malecho.time
scene A malmal.damp=0.55
scene B malmal.damp=0.9
