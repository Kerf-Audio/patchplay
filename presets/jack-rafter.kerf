kerf 1
tempo 160
key G minor pentatonic
tags footwork polyrhythm

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.85 level2=0.8 level3=0.5 level4=0.6 level5=0.4 level6=0.5 send=0.3
module room Kiln size=0.6 heat=0.45 bloom=0.35 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.3125 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.45 punch=0.55 decay=0.3 tone=0.5
  module r_kick2 Ruler hits_a=0 hits_b=0.1875 hits_c=0 hits_d=0 steps_b=1 rotate=0.125 chance=0.8
  module kick2 Mortise engine=0 pitch=0.45 punch=0.55 decay=0.2 tone=0.5
  module r_clap Ruler hits_a=0.1875 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.25
  module clap Mortise engine=0.75 pitch=0.55 punch=0.5 decay=0.25 tone=0.5
  module r_chat Ruler hits_a=0 hits_b=0.6875 hits_c=0 hits_d=0 steps_b=1 chance=0.9
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.05 tone=0.65
  module r_tom Ruler hits_a=0 hits_b=0.375 hits_c=0 hits_d=0 steps_b=0.4667 rotate=0.125 chance=0.7
  module tom Mortise engine=1 pitch=0.5 punch=0.5 decay=0.2 tone=0.5
  module r_vox Ruler hits_a=0 hits_b=0.125 hits_c=0 hits_d=0 steps_b=1 rotate=0.3125 chance=0.7
  module vox Veneer slice=0.34 speed=0.6 reverse=0 looped=0

part bass "Sub" colour #3d63c9 level=0.85
  module bassseq Dovetail steps_a=1 steps_b=0.1333 interlock=0.3 chance=1 glide=0.1 range=0.1
  module bassfret Fret root=0.5833 scale=0.14 octave=0.25
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.6 sustain=0.7 release=0.5 curve=0.4
  module bassflt Plane cutoff=0.3 res=0.2 mode=0 drive=0.1
  module bassamp Clamp level=0 response=0.1

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_kick2.clock
cable r_kick2.b -> kick2.trig
cable kick2.out -> mix.in1
cable clock.clock -> r_clap.clock
cable r_clap.a -> clap.trig
cable clap.out -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.b -> chat.trig
cable chat.out -> mix.in3
cable clock.clock -> r_tom.clock
cable r_tom.b -> tom.trig
cable tom.out -> mix.in4
cable clock.clock -> r_vox.clock
cable r_vox.b -> vox.trig
cable vox.l -> mix.in4
cable vox.r -> mix.in4

cable clock.clock -> bassseq.clock
cable bassseq.pitch -> bassfret.pitch
cable bassfret.pitch -> bassosc.voct
cable bassseq.gate -> bassenv.gate
cable bassosc.sine -> bassflt.in
cable bassflt.out -> bassamp.in
cable bassenv.env -> bassamp.cv
cable bassamp.out -> mix.in2

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A bassflt.cutoff=0.18
scene B bassflt.cutoff=0.45
