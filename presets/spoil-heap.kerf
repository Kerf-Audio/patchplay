kerf 1
tempo 100
key C minor
tags noise texture

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.8 level2=0.6 level3=0.5 level4=0.6 level5=0.5 level6=0.6 send=0.3
module room Kiln size=0.6 heat=0.5 bloom=0.3 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.1875 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.35 punch=0.55 decay=0.4 tone=0.5
  module r_snare Ruler hits_a=0 hits_b=0.125 hits_c=0 hits_d=0 steps_b=1 rotate=0.375 chance=0.7
  module snare Mortise engine=0.25 pitch=0.55 punch=0.5 decay=0.4 tone=0.8
  module r_chat Ruler hits_a=0 hits_b=1 hits_c=0 hits_d=0 steps_b=1 chance=0.5
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.03 tone=0.65

part tex "Static" colour #3da3a3 level=0.6
  module texsrc Sawdust colour=0.8 crackle=0.5
  module texflt Plane cutoff=0.6 res=0.5 mode=0.33 drive=0.1
  module texamp Clamp level=0 response=0.4
  module texrhy Ruler hits_a=0.4375 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0
  module texenv Bevel attack=0.02 decay=0.3 sustain=0 release=0.25 curve=0.35
  module texburl Burl rate=0.2 smooth=0.8 bias=0.5
  module texlfo Spokeshave rate=0.17 spread=0.5 shape=0 phase=0.25

part rum "Rumble" colour #3da3a3 level=0.6
  module rumsrc Sawdust colour=0.1 crackle=0
  module rumflt Plane cutoff=0.3 res=0.3 mode=0 drive=0.1
  module rumamp Clamp level=0.5 response=0.4
  module rumburl Burl rate=0.2 smooth=0.8 bias=0.5
  module rumlfo Spokeshave rate=0.03 spread=0.5 shape=0 phase=0.25

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_snare.clock
cable r_snare.b -> snare.trig
cable snare.out -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.b -> chat.trig
cable chat.out -> mix.in3

cable texsrc.noise -> texflt.in
cable texflt.out -> texamp.in
cable clock.clock -> texrhy.clock
cable texrhy.a -> texenv.gate
cable texenv.env -> texamp.cv
cable texamp.out -> mix.in6
cable texburl.drift -> texflt.cutoff
cable texlfo.lfo1 -> texflt.cutoff

cable rumsrc.noise -> rumflt.in
cable rumflt.out -> rumamp.in
cable rumamp.out -> mix.in6
cable rumburl.drift -> rumflt.cutoff
cable rumlfo.lfo1 -> rumflt.cutoff

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A texflt.cutoff=0.48 rumflt.cutoff=0.18
scene B texflt.cutoff=0.75 rumflt.cutoff=0.45
