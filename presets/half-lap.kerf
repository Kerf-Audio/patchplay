kerf 1
tempo 114
key E dorian
tags disco four-four

module clock Tally tempo=0.5 swing=0.1 divide=0.5
module mix Router level1=0.85 level2=0.7 level3=0.5 level4=0.6 level5=0.5 level6=0.5 send=0.3
module room Kiln size=0.6 heat=0.45 bloom=0.35 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.25 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.45 punch=0.55 decay=0.25 tone=0.5
  module r_clap Ruler hits_a=0.125 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.25
  module clap Mortise engine=0.75 pitch=0.55 punch=0.5 decay=0.28 tone=0.5
  module r_ohat Ruler hits_a=0.25 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.125
  module ohat Mortise engine=0.5 pitch=0.5 punch=0.5 decay=0.4 tone=0.7
  module r_chat Ruler hits_a=0 hits_b=1 hits_c=0 hits_d=0 steps_b=1 chance=0.7
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.04 tone=0.65

part bass "Octaves" colour #3d63c9 level=0.85
  module bassseq Dovetail steps_a=1 steps_b=0.1333 interlock=0.9 chance=1 glide=0 range=0.2
  module bassfret Fret root=0.3333 scale=0.57 octave=0.25
  module bassosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module bassenv Bevel attack=0 decay=0.2 sustain=0 release=0.15 curve=0.4
  module bassflt Plane cutoff=0.4 res=0.25 mode=0 drive=0.2
  module bassamp Clamp level=0 response=0.1

part pad "Strings" colour #7a4fb5 level=0.5
  module padseq Dovetail steps_a=0.4667 steps_b=0.0667 interlock=0 chance=1 glide=0.1 range=0.3
  module padfret Fret root=0.3333 scale=0.57 octave=0.5
  module padply Ply layers=0.9 detune=0.3 width=1 tone=0.5
  module padflt Plane cutoff=0.55 res=0.15 mode=0 drive=0
  module paddrift Spokeshave rate=0.12 spread=0.5 shape=0 phase=0.25

part lick "Guitar" colour #d1a233 level=0.5
  module lickseq Dovetail steps_a=1 steps_b=0.4 interlock=0.6 chance=0.6 glide=0 range=0.3
  module lickfret Fret root=0.3333 scale=0.57 octave=0.5
  module lickosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module lickenv Bevel attack=0 decay=0.1 sustain=0 release=0.2 curve=0.4
  module lickflt Plane cutoff=0.55 res=0.2 mode=0 drive=0.15
  module lickamp Clamp level=0 response=0.5
  module lickecho Bandsaw time=0.375 feedback=0.35 wear=0.35 mix=1

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_clap.clock
cable r_clap.a -> clap.trig
cable clap.out -> mix.in4
cable clock.clock -> r_ohat.clock
cable r_ohat.a -> ohat.trig
cable ohat.out -> mix.in3
cable clock.clock -> r_chat.clock
cable r_chat.b -> chat.trig
cable chat.out -> mix.in3

cable clock.clock -> bassseq.clock
cable bassseq.pitch -> bassfret.pitch
cable bassfret.pitch -> bassosc.voct
cable bassseq.gate -> bassenv.gate
cable bassosc.saw -> bassflt.in
cable bassflt.out -> bassamp.in
cable bassenv.env -> bassamp.cv
cable bassamp.out -> mix.in2

cable clock.bar -> padseq.clock
cable padseq.pitch -> padfret.pitch
cable padfret.pitch -> padply.voct
cable padply.l -> padflt.in
cable padply.r -> padflt.in
cable paddrift.lfo1 -> padflt.cutoff
cable padflt.out -> mix.in6

cable clock.clock -> lickseq.clock
cable lickseq.pitch -> lickfret.pitch
cable lickfret.pitch -> lickosc.voct
cable lickseq.gate -> lickenv.gate
cable lickosc.square -> lickflt.in
cable lickflt.out -> lickamp.in
cable lickenv.env -> lickamp.cv
cable lickamp.out -> mix.in5
cable clock.clock -> lickecho.clock
cable lickamp.out -> lickecho.in
cable lickecho.l -> mix.in5
cable lickecho.r -> mix.in5

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A bassflt.cutoff=0.28 padflt.cutoff=0.4 lickflt.cutoff=0.43
scene B bassflt.cutoff=0.55 padflt.cutoff=0.75 lickflt.cutoff=0.7
