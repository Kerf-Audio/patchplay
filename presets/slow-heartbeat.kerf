kerf 1
tempo 60
key C minor
tags ominous heartbeat dark

module clock Tally tempo=0.5 swing=0 divide=0
module mix Router level1=0.9 level2=0.6 level3=0.8 level4=0.9 level5=0.5 level6=0.5 send=0.45
module room Kiln size=0.8 heat=0.5 bloom=0.4 mix=1
module out Finish volume=0.7 glue=0.35 ceiling=0.8

part heart "Heartbeat" colour #c94a3d
  module beatrl Ruler hits_a=0.4 hits_b=0 hits_c=0 hits_d=0 steps_a=0.2667 steps_b=1 rotate=0 chance=1
  module thud Mortise engine=0 pitch=0.12 punch=0.2 decay=0.3 tone=0.1
  module accenttr Tread step1=1 step2=0.62 step3=1 step4=1 step5=1 step6=1 step7=1 step8=1 length=0.1429 glide=0 rate=0.5 direction=0 depth=1
  module thudflt Plane cutoff=0.4 res=0.1 mode=0 drive=0

part pad "Cold pad" colour #5a4a7a level=0.55
  module padtr Tread step1=0.4 step2=0.4 step3=0.3917 step4=0.4 step5=0.4 step6=0.4 step7=0.4 step8=0.4 length=0.2857 glide=0.5 rate=0.5 direction=0 depth=1
  module padwarp Warp amount=0.12 speed=0.1 rough=0.2 chaos=0.3
  module pad1 Chisel tune=0.5 fine=0.5 shape=0.7 pw=0.5
  module pad2 Chisel tune=0.5208 fine=0.5 shape=0.7 pw=0.5
  module padflt Plane cutoff=0.3 res=0.3 mode=0 drive=0.1
  module padamp Clamp level=0.3 response=0
  module padlfo Rocker rate=0.1 sync=0 shape=0 depth=0.5 offset=0.5

part breath "Breath" colour #3da3a3 level=0.9
  module breath Sawdust colour=0.35 crackle=0.02
  module breathflt Plane cutoff=0.45 res=0.35 mode=0.33 drive=0
  module breathamp Clamp level=0 response=0
  module breathlfo Rocker rate=0.13 sync=0 shape=0 depth=0.5 offset=0.5
  module whisper Static tune=0.6 width=0.3 hiss=0.2 crackle=0.15 whistle=0.2 fade=0.65 ghost=0.6 level=0.3

part toll "Far bell" colour #d1a233 level=0.5
  module tollrl Ruler hits_a=0 hits_b=0.0625 hits_c=0 hits_d=0 steps_a=1 steps_b=1 rotate=0 chance=0.3
  module toll Mallet material=0.55 size=0.55 strike=0.3 damp=0.8

part spring "Nerves" colour #b5527a level=1
  module nerves Chatter energy=0.65 tension=0.45 damping=0.35 rate=0.0 depth=0.9

cable clock.clock -> beatrl.clock
cable beatrl.a -> thud.trig
cable beatrl.a -> accenttr.clock
cable accenttr.cv -> thud.accent
cable thud.out -> thudflt.in
cable thudflt.out -> mix.in1
cable beatrl.a -> nerves.kick
cable nerves.position -> padflt.cutoff
cable nerves.velocity -> breathflt.cutoff
cable clock.bar -> padtr.clock
cable padtr.cv -> padwarp.in
cable padwarp.out -> pad1.voct
cable padwarp.out -> pad2.voct
cable pad1.sine -> padflt.in
cable pad2.sine -> padflt.in
cable padlfo.out -> padflt.cutoff
cable padflt.out -> padamp.in
cable padlfo.out -> padamp.cv
cable padamp.out -> mix.in2
cable breath.noise -> breathflt.in
cable breathflt.out -> breathamp.in
cable breathlfo.out -> breathamp.cv
cable breathamp.out -> mix.in3
cable whisper.out -> mix.in3
cable clock.clock -> tollrl.clock
cable tollrl.b -> toll.trig
cable toll.out -> mix.in4
cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A thud.decay=0.22 padflt.cutoff=0.22 nerves.energy=0.4
scene B thud.decay=0.4 padflt.cutoff=0.45 nerves.energy=0.9
