  module ruler1 Ruler   hits_a=0.25 steps_a=1 hits_b=0.2 steps_b=0.667 hits_c=0.45 steps_c=0.4 hits_d=0 chance=0.6
  module ruler2 Ruler   hits_a=0.125 steps_a=1 hits_b=0 hits_c=0 hits_d=0 rotate=0.5
  module kick   Veneer  slice=0.03 speed=0.2 reverse=0 looped=0
  module snap   Veneer  slice=0.34 speed=0.5 reverse=0 looped=0
  module tick   Veneer  slice=0.97 speed=0.65 reverse=0 looped=0
  module rattle Veneer  slice=0.6 speed=0.55 reverse=0 looped=0
  module pickr  Burl    rate=0.5 smooth=0.1 bias=0.6

