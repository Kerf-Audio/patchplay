  module hold   Veneer    slice=0.4 speed=0.4 reverse=0 looped=1
  module drift  Spokeshave rate=0.2 spread=0.6 shape=0 phase=0.25
  module fog    Shavings  size=0.6 density=0.5 spray=0.5 pitch=0.5
  module echo   Bandsaw   time=0.45 feedback=0.4 wear=0.45 mix=0.4

