  module lseq  Dovetail steps_a=0.2 steps_b=0.13 interlock=0.6 chance=0.8 glide=0 range=0.1
  module lfret Fret     root=0.75 scale=0.4286 octave=0.25
  module sub   Veneer   slice=0.15 speed=0.5 reverse=0 looped=0

