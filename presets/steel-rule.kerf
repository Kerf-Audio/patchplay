module out    Finish volume=0.7 glue=0.5 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module beat   Ruler   hits_a=0.25 steps_a=1 hits_b=0 hits_c=0 hits_d=0 chance=1
  module snap   Ruler   hits_a=0.125 steps_a=1 hits_b=0.15 steps_b=0.4 hits_c=0 hits_d=0 rotate=0.25 chance=0.4
  module hats   Ruler   hits_a=0.25 steps_a=1 hits_b=0.5 steps_b=1 hits_c=0 hits_d=0 rotate=0.125 chance=0.3
  module kick   Mortise engine=0 pitch=0.32 punch=0.75 decay=0.28 tone=0.35
  module clap   Mortise engine=0.75 pitch=0.5 punch=0.8 decay=0.12 tone=0.6
  module clip   Rasp    drive=0.55 fold=0 bias=0.5 mix=0.6
  module hat    Mortise engine=0.5 pitch=0.68 punch=0.5 decay=0.05 tone=0.8

part acid "Resonant line" colour #3d63c9 level=0.8
  module bseq   Dovetail steps_a=1 steps_b=0.87 interlock=0.6 chance=0.85 glide=0.2 range=0.3
  module bfret  Fret     root=0.75 scale=0.143 octave=0.25
  module bosc   Chisel   tune=0.5 shape=0 pw=0.5
  module bdrive Rasp     drive=0.3 fold=0.15 bias=0.55 mix=0.8
  module benv   Bevel    attack=0 decay=0.3 sustain=0 release=0.15 curve=0.3
  module bflt   Plane    cutoff=0.28 res=0.75 mode=0 drive=0.3
  module bamp   Clamp    level=0 response=0.1
  module sweep  Rocker   rate=0.3 sync=0.15 shape=0.15 depth=0.45 offset=0.5 phase=0
  module squeeze Vise    squeeze=0.6 speed=0.7 makeup=0.35

part sub "Sine sub" colour #3d9c8a level=0.8
  module sosc   Chisel   tune=0.5 shape=0 pw=0.5
  module senv   Bevel    attack=0.01 decay=0.4 sustain=0.5 release=0.15 curve=0.45
  module samp   Clamp    level=0 response=0.05

part bleeps "Bleeps" colour #d1a233 level=0.5
  module lrhy   Ruler   hits_a=0.3125 steps_a=1 hits_b=0 hits_c=0 hits_d=0 chance=1
  module tread  Tread   step1=0.6 step2=0.5 step3=0.8 step4=0.4 step5=0.7 step6=0.5 step7=0.9 step8=0.3 length=0.857 direction=0 glide=0 depth=0.25
  module lfret  Fret    root=0.75 scale=0.143 octave=0.625
  module losc   Chisel  tune=0.5 shape=0 pw=0.5
  module lenv   Bevel   attack=0 decay=0.12 sustain=0 release=0.08 curve=0.3
  module lamp   Clamp   level=0 response=0.5
  module lecho  Dado    time=0.43 sync=1 feedback=0.45 tone=0.45 thin=0.35 wobble=0.25 drive=0.15 mix=0.35

cable tally1.clock -> beat.clock
cable tally1.clock -> snap.clock
cable tally1.clock -> hats.clock
cable beat.a -> kick.trig
cable snap.a -> clap.trig
cable snap.b -> clap.trig
cable hats.a -> hat.trig
cable hats.b -> hat.trig
cable kick.out -> mix.in1
cable clap.out -> clip.in
cable clip.out -> mix.in4
cable hat.out -> mix.in3

cable tally1.clock -> bseq.clock
