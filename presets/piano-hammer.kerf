kerf 1
tempo 128
key A minor
tags four-four techno detroit

module tally1 Tally tempo=0.5 swing=0.05 divide=0.5
module mix    Router level1=0.85 level2=0.6 level3=0.4 level4=0.5 level5=0.7 level6=0.5 send=0.18
module room   Kiln   size=0.5 heat=0.55 bloom=0.2 mix=1
module out    Finish volume=0.7 glue=0.45 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module beat     Ruler   hits_a=0.25 steps_a=1 hits_b=0 hits_c=0 hits_d=0 chance=1
  module backbeat Ruler   hits_a=0.125 steps_a=1 hits_b=0.3 steps_b=0.4 hits_c=0 hits_d=0 rotate=0.25 chance=0.5
  module hats     Ruler   hits_a=0.25 steps_a=1 hits_b=0.75 steps_b=1 hits_c=0 hits_d=0 rotate=0.125 chance=0.45
  module kick     Mortise engine=0 pitch=0.33 punch=0.75 decay=0.3 tone=0.35
  module clap     Mortise engine=0.75 pitch=0.45 punch=0.7 decay=0.3 tone=0.5
  module rim      Mortise engine=0.25 pitch=0.8 punch=0.8 decay=0.05 tone=0.8
  module hat      Mortise engine=0.5 pitch=0.6 punch=0.4 decay=0.2 tone=0.65

part stabs "Chord stabs" colour #d1a233 level=0.9
  module srhy  Ruler   hits_a=0.3125 steps_a=1 hits_b=0 hits_c=0 hits_d=0 chance=1
  module sseq  Dovetail steps_a=0.47 steps_b=0.2 interlock=0 chance=1 glide=0 range=0.15
  module sfret Fret    root=0.75 scale=0.43 octave=0.5
  module smit  Mitre   chord=0.538 inversion=0.33 spread=0.33 root=0.75
  module s1    Chisel  tune=0.5 fine=0.5 shape=0 pw=0.5
  module s2    Chisel  tune=0.5 fine=0.53 shape=0 pw=0.5
  module s3    Chisel  tune=0.5 fine=0.47 shape=0 pw=0.5
  module senv  Bevel   attack=0 decay=0.28 sustain=0 release=0.2 curve=0.35 depth=0.6
  module sflt  Plane   cutoff=0.4 res=0.25 mode=0 drive=0.3
  module samp  Clamp   level=0 response=0.1
  module secho Dado    time=0.43 sync=1 feedback=0.5 tone=0.4 thin=0.35 wobble=0.3 drive=0.25 mix=0.4

part bass "Offbeat bass" colour #3d63c9 level=0.95
  module bosc  Chisel  tune=0.25 shape=0 pw=0.5
  module benv  Bevel   attack=0 decay=0.22 sustain=0.1 release=0.15 curve=0.3
  module bflt  Plane   cutoff=0.3 res=0.3 mode=0 drive=0.3
  module bamp  Clamp   level=0 response=0.1

cable tally1.clock -> beat.clock
cable tally1.clock -> backbeat.clock
cable tally1.clock -> hats.clock
cable beat.a -> kick.trig
cable backbeat.a -> clap.trig
cable backbeat.b -> rim.trig
cable hats.a -> hat.trig
cable hats.b -> hat.trig
cable kick.out -> mix.in1
cable clap.out -> mix.in4
cable rim.out -> mix.in4
cable hat.out -> mix.in3

cable tally1.clock -> srhy.clock
cable tally1.div4 -> sseq.clock
cable sseq.pitch -> sfret.pitch
cable sfret.pitch -> smit.pitch
cable srhy.a -> smit.gate
cable smit.voice1 -> s1.voct
cable smit.voice2 -> s2.voct
cable smit.voice3 -> s3.voct
cable smit.gate -> senv.gate
cable s1.saw -> sflt.in
cable s2.saw -> sflt.in
cable s3.saw -> sflt.in
cable senv.env -> sflt.cutoff
cable sflt.out -> samp.in
cable senv.env -> samp.cv
cable samp.out -> secho.in_l
cable secho.l -> mix.in5
cable secho.r -> mix.in5

cable sfret.pitch -> bosc.voct
cable hats.a -> benv.gate
cable bosc.saw -> bflt.in
cable benv.env -> bflt.cutoff
cable bflt.out -> bamp.in
cable benv.env -> bamp.cv
cable bamp.out -> mix.in2

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A sflt.cutoff=0.3 secho.feedback=0.4 hats.chance=0.3 smit.chord=0.538
scene B sflt.cutoff=0.5 secho.feedback=0.65 hats.chance=0.8 smit.chord=0.692
