kerf 1
tempo 86
key A dorian
tags lofi samples chance

module clock Tally tempo=0.5 swing=0.25 divide=0.5
module mix Router level1=0.8 level2=0.65 level3=0.5 level4=0.6 level5=0.5 level6=0.4 send=0.3
module room Kiln size=0.5 heat=0.7 bloom=0.3 mix=1
module out Finish volume=0.7 glue=0.4 ceiling=0.8

part drums "Drums" colour #c94a3d level=0.9
  module r_kick Ruler hits_a=0.1875 hits_b=0 hits_c=0 hits_d=0 steps_a=1
  module kick Mortise engine=0 pitch=0.4 punch=0.55 decay=0.28 tone=0.5
  module r_snare Ruler hits_a=0.0625 hits_b=0 hits_c=0 hits_d=0 steps_a=1 rotate=0.5
  module snare Mortise engine=0.25 pitch=0.55 punch=0.5 decay=0.28 tone=0.4
  module r_loop Ruler hits_a=0 hits_b=0.1875 hits_c=0 hits_d=0 steps_b=1 rotate=0.125 chance=0.7
  module loop Veneer slice=0.2 speed=0.45 reverse=0 looped=0
  module r_chat Ruler hits_a=0 hits_b=0.4375 hits_c=0 hits_d=0 steps_b=1 chance=0.8
  module chat Mortise engine=0.5 pitch=0.62 punch=0.5 decay=0.06 tone=0.45

part keys "Keys" colour #d1a233 level=0.5
  module keysseq Dovetail steps_a=0.4667 steps_b=0.4 interlock=0.5 chance=0.75 glide=0.1 range=0.3
  module keysfret Fret root=0.75 scale=0.57 octave=0.5
  module keysosc Chisel tune=0.5 fine=0.5 shape=0 pw=0.5
  module keysenv Bevel attack=0 decay=0.4 sustain=0.2 release=0.4 curve=0.4
  module keysflt Plane cutoff=0.4 res=0.15 mode=0 drive=0.1
  module keysamp Clamp level=0 response=0.5
  module keysburl Burl rate=0.25 smooth=0.7 bias=0.5

part tex "Hiss" colour #3da3a3 level=0.3
  module texsrc Sawdust colour=0.4 crackle=0.9
  module texflt Plane cutoff=0.5 res=0.1 mode=0 drive=0.1
  module texamp Clamp level=0.5 response=0.4

cable clock.clock -> r_kick.clock
cable r_kick.a -> kick.trig
cable kick.out -> mix.in1
cable clock.clock -> r_snare.clock
cable r_snare.a -> snare.trig
cable snare.out -> mix.in4
cable clock.clock -> r_loop.clock
cable r_loop.b -> loop.trig
cable loop.l -> mix.in4
cable loop.r -> mix.in4
cable clock.clock -> r_chat.clock
cable r_chat.b -> chat.trig
cable chat.out -> mix.in3

cable clock.clock -> keysseq.clock
cable keysseq.pitch -> keysfret.pitch
cable keysfret.pitch -> keysosc.voct
cable keysseq.gate -> keysenv.gate
cable keysosc.sine -> keysflt.in
cable keysflt.out -> keysamp.in
cable keysenv.env -> keysamp.cv
cable keysamp.out -> mix.in5
cable keysburl.drift -> keysflt.cutoff

cable texsrc.dust -> texflt.in
cable texflt.out -> texamp.in
cable texamp.out -> mix.in6

cable mix.send -> room.in_l
cable mix.send -> room.in_r
cable mix.mix_l -> out.l
cable mix.mix_r -> out.r
cable room.l -> out.l
cable room.r -> out.r

scene A keysflt.cutoff=0.28 texflt.cutoff=0.38
scene B keysflt.cutoff=0.55 texflt.cutoff=0.65
